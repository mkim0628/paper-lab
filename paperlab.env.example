# Paper Lab 설정 파일. start.bat 이 처음 실행될 때 paperlab.env 로 복사됩니다 (paperlab.env 는 git 에 올라가지 않습니다).
# '키=값' 형식이며, 값이 비어 있거나 '#' 으로 시작하는 줄은 무시됩니다. 아래는 모두 선택 사항입니다.
# 저장 후 start.bat 을 다시 실행하면 적용됩니다.
#
# ※ Claude API 키는 여기가 아니라 앱의 [설정] 탭에서 프로필로 등록합니다.

# 관련 연구 조회용 무료 API 키 (없어도 동작하지만 rate limit 에 자주 걸릴 수 있음)
PAPERLAB_S2_API_KEY=
# OpenAlex: 후속 연구(이 논문을 인용한 논문 상위 목록)에 사실상 필요
PAPERLAB_OPENALEX_API_KEY=
# 공개 코드 탐색용 GitHub 토큰 (권한 없는 읽기용이면 충분)
PAPERLAB_GITHUB_TOKEN=

# 시작할 때 업데이트 확인 방식: ask(기본, 새 버전이 있으면 경고 창으로 물어봄) / auto(묻지 않고 업데이트) / off(확인 안 함)
# PAPERLAB_UPDATE_CHECK=ask

# 포트 / 데이터 저장 위치를 바꾸려면 앞의 '#' 을 지우고 수정하세요
# PAPERLAB_PORT=8000
# PAPERLAB_DATA=D:\PaperLabData

# 회사/학교망에서 pip 설치나 arXiv 접속에 프록시가 필요하면
# HTTPS_PROXY=http://proxy.example.com:8080
